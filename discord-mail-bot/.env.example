# Get this from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=REPLACE_WITH_DISCORD_BOT_TOKEN
# ID of the Discord server where /mailpanel should be registered.
DISCORD_GUILD_ID=REPLACE_WITH_SERVER_ID
# Absolute path to the Minecraft DEDICATED server's config/cybernpc-discord-mail
# The bot must run on the same machine or have access to the SAME shared folder.
# Windows example: C:\MinecraftServer\config\cybernpc-discord-mail
# Linux example: /srv/minecraft/config/cybernpc-discord-mail
MAIL_DIR=REPLACE_WITH_ABSOLUTE_MAIL_DIRECTORY
